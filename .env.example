# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略。
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash

# 本地 PostgreSQL 连接串，仅供 CP3-02、CP3-04~07 使用。
LANGGRAPH_DB_URL=postgresql://langgraph_user:change_me@localhost:5432/langgraph_db?sslmode=disable

# 可选：改变示例使用的线程，避免复用旧检查点。
CP3_ERROR_THREAD_ID=chapter03-05
CP3_REPLAY_THREAD_ID=chapter03-08
CP3_FORK_THREAD_ID=chapter03-08-fork
